<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="Pawscent.App.Views.NewProfileDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="New profile"
    PrimaryButtonText="Create"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    IsPrimaryButtonEnabled="False">
    <StackPanel Spacing="8" MinWidth="320">
        <TextBox x:Name="NameBox" Header="Profile name" TextChanged="NameBox_TextChanged" />
        <TextBlock x:Name="ErrorText" Foreground="{ThemeResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" />
    </StackPanel>
</ContentDialog>
