<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Pawscent.App.Views.ProfileView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Year tabs are inserted in front of Categories and Receipts by the code-behind. -->
    <TabView x:Name="Tabs"
             IsAddTabButtonVisible="True"
             AddTabButtonCommand="{x:Bind ViewModel.AddYearCommand}"
             CanDragTabs="False"
             CanReorderTabs="False"
             TabWidthMode="SizeToContent">
        <TabViewItem x:Name="CategoriesTab" Header="Categories" IsClosable="False">
            <TabViewItem.IconSource>
                <SymbolIconSource Symbol="Tag" />
            </TabViewItem.IconSource>
        </TabViewItem>
        <TabViewItem x:Name="ReceiptsTab" Header="Receipts" IsClosable="False">
            <TabViewItem.IconSource>
                <SymbolIconSource Symbol="Document" />
            </TabViewItem.IconSource>
        </TabViewItem>
    </TabView>
</UserControl>
