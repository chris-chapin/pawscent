<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="Pawscent.App.Views.ExpenseDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Pawscent.App.ViewModels"
    xmlns:expenses="using:Pawscent.Core.Expenses"
    Title="{x:Bind ViewModel.Title}"
    PrimaryButtonText="Save"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    PrimaryButtonClick="ContentDialog_PrimaryButtonClick">
    <StackPanel Spacing="12" MinWidth="440">
        <CalendarDatePicker Header="Date" Date="{x:Bind ViewModel.Date, Mode=TwoWay}" HorizontalAlignment="Stretch" />

        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="100" />
            </Grid.ColumnDefinitions>
            <NumberBox x:Name="AmountBox" Header="Amount" Value="{x:Bind ViewModel.Amount, Mode=TwoWay}"
                       SpinButtonPlacementMode="Hidden" AcceptsExpression="False" />
            <TextBox Grid.Column="1" Header="Currency" MaxLength="3" CharacterCasing="Upper"
                     Text="{x:Bind ViewModel.Currency, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        </Grid>

        <TextBox Header="Description" Text="{x:Bind ViewModel.Description, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ComboBox Header="Category" HorizontalAlignment="Stretch" PlaceholderText="Choose a category"
                      ItemsSource="{x:Bind ViewModel.Categories}"
                      SelectedItem="{x:Bind ViewModel.SelectedCategory, Mode=TwoWay}">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="expenses:Category">
                        <TextBlock Text="{x:Bind Name}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <Button x:Name="NewCategoryButton" Grid.Column="1" VerticalAlignment="Bottom" Content="New category...">
                <Button.Flyout>
                    <Flyout x:Name="NewCategoryFlyout" Opened="NewCategoryFlyout_Opened">
                        <StackPanel Spacing="8" MinWidth="260">
                            <TextBox x:Name="NewCategoryBox" Header="Category name" KeyDown="NewCategoryBox_KeyDown" />
                            <TextBlock Text="{x:Bind ViewModel.AddError, Mode=OneWay}" TextWrapping="Wrap"
                                       Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                            <Button Content="Add" Style="{StaticResource AccentButtonStyle}" Click="AddCategory_Click" />
                        </StackPanel>
                    </Flyout>
                </Button.Flyout>
            </Button>
        </Grid>

        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ComboBox Header="Receipt" HorizontalAlignment="Stretch" PlaceholderText="Choose a receipt"
                      ItemsSource="{x:Bind ViewModel.Receipts}"
                      SelectedItem="{x:Bind ViewModel.SelectedReceipt, Mode=TwoWay}">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:ReceiptRow">
                        <TextBlock Text="{x:Bind FileName}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <Button Grid.Column="1" VerticalAlignment="Bottom" Content="Add file..."
                    Command="{x:Bind ViewModel.AddReceiptCommand}" />
        </Grid>

        <TextBlock Text="{x:Bind ViewModel.AddError, Mode=OneWay}" TextWrapping="Wrap"
                   Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
        <TextBlock Text="{x:Bind ViewModel.ErrorText, Mode=OneWay}" TextWrapping="Wrap"
                   Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
    </StackPanel>
</ContentDialog>
